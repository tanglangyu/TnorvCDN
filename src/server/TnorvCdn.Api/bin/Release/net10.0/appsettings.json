{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=127.0.0.1;Database=tnorv;Username=postgres;Password=<YOUR_DB_PASSWORD>"
  },
  "Jwt": {
    "Key": "<CHANGE-ME-jwt-secret-at-least-32-bytes-long>"
  },
  "Dns": {
    "Enabled": "false",
    "Provider": "aggregated",
    "DefaultDomainId": "",
    "Providers": {
      "Aggregated": {
        "ApiBase": "https://your-dns-api.example.com/",
        "Uid": "",
        "Key": ""
      },
      "Aliyun": { "AccessKeyId": "", "AccessKeySecret": "" },
      "Dnspod": { "SecretId": "", "SecretKey": "" },
      "Huawei": { "AccessKeyId": "", "SecretAccessKey": "" },
      "Cloudflare": { "ApiToken": "" }
    }
  }
}
